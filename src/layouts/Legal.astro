---
import Base from './Base.astro';
import Section from '../components/Section.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description: string;
  /** Encabezado visible (H1) */
  heading: string;
  /** Bajada corta bajo el H1 */
  intro: string;
  /** Fecha legible de última actualización */
  updated: string;
}

const { title, description, heading, intro, updated } = Astro.props;

const pages = [
  { label: 'Términos', href: '/terminos' },
  { label: 'Privacidad', href: '/privacidad' },
  { label: 'Aviso legal', href: '/aviso-legal' },
];

const current = Astro.url.pathname.replace(/\/$/, '');
---

<Base title={title} description={description}>
  <!-- Barra superior simple (las páginas legales no usan el nav con anclas) -->
  <header class="w-full border-b border-border bg-bg">
    <Section innerClass="flex flex-wrap items-center justify-between gap-4 py-5">
      <a
        href="/"
        class="inline-flex min-h-[44px] items-center gap-2 rounded-md font-sans text-sm text-muted-light transition-colors duration-300 hover:text-bitcoin focus-visible:text-bitcoin focus-visible:outline-none"
        style="transition-timing-function:var(--ease);"
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="19" y1="12" x2="5" y2="12" />
          <polyline points="12 19 5 12 12 5" />
        </svg>
        Volver al curso
      </a>

      <nav aria-label="Documentos legales">
        <ul class="flex flex-wrap items-center gap-1">
          {
            pages.map((p) => (
              <li>
                <a
                  href={p.href}
                  aria-current={current === p.href ? 'page' : undefined}
                  class={
                    'inline-flex min-h-[44px] items-center rounded-pill px-4 py-2 font-sans text-sm transition-colors duration-300 ' +
                    (current === p.href
                      ? 'bg-white/10 font-bold text-bitcoin'
                      : 'text-muted hover:text-bitcoin')
                  }
                  style="transition-timing-function:var(--ease);"
                >
                  {p.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </Section>
  </header>

  <main class="bg-bg">
    <Section innerClass="py-14 md:py-20">
      <div class="max-w-[820px]">
        <p class="font-sans text-eyebrow font-bold uppercase tracking-[0.24px] text-bitcoin">
          Legal
        </p>
        <h1 class="mt-3 font-sans text-h2 font-bold text-title">{heading}</h1>
        <p class="mt-4 font-sans text-body text-muted-light">{intro}</p>
        <p class="mt-2 font-sans text-small text-muted">
          Última actualización: {updated}
        </p>

        <div class="legal mt-10">
          <slot />
        </div>
      </div>
    </Section>
  </main>

  <Footer />
</Base>

<style is:global>
  /* Tipografía de documento legal. Solo aplica dentro de .legal */
  .legal {
    font-family: 'Plus Jakarta Sans', sans-serif;
    color: #8b8a88;
    font-size: clamp(0.95rem, 2.2vw, 1rem);
    line-height: 1.7;
  }
  .legal h2 {
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    font-size: clamp(1.25rem, 3vw, 1.5rem);
    line-height: 1.25;
    font-weight: 700;
    color: #ebecf0;
    scroll-margin-top: 5rem;
  }
  .legal h3 {
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
    font-size: 1.0625rem;
    line-height: 1.35;
    font-weight: 700;
    color: #f5f5f5;
  }
  .legal p {
    margin-bottom: 1rem;
  }
  .legal ul,
  .legal ol {
    margin: 0 0 1.25rem 1.25rem;
    padding: 0;
  }
  .legal ul {
    list-style: disc;
  }
  .legal ol {
    list-style: decimal;
  }
  .legal li {
    margin-bottom: 0.5rem;
  }
  .legal li::marker {
    color: #f7931a;
  }
  .legal strong {
    color: #f5f5f5;
    font-weight: 700;
  }
  .legal a {
    color: #f7931a;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .legal hr {
    margin: 2.5rem 0;
    border: 0;
    border-top: 1px solid #3a3a3a;
  }
  /* Bloque destacado para avisos fuertes */
  .legal .aviso {
    margin: 1.75rem 0;
    border: 1px solid #3a3a3a;
    border-left: 3px solid #f7931a;
    border-radius: 12px;
    background: rgba(22, 22, 22, 0.85);
    padding: 1.25rem 1.25rem 0.5rem;
  }
  .legal .aviso > :last-child {
    margin-bottom: 1rem;
  }
  .legal table {
    width: 100%;
    margin-bottom: 1.5rem;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }
  .legal th,
  .legal td {
    border: 1px solid #3a3a3a;
    padding: 0.625rem 0.75rem;
    text-align: left;
    vertical-align: top;
  }
  .legal th {
    color: #f5f5f5;
    font-weight: 700;
  }
</style>
