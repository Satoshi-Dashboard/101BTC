---
import Reveal from './Reveal.astro';
import { mensajePara } from '../lib/leads/config';
---

<section
  id="inicio"
  class="relative isolate flex min-h-screen w-full items-end overflow-hidden bg-bg"
>
  <!-- Capa 1: fondo normal (eager: above the fold) -->
  <img
    src="/img/hero-bg.png"
    alt=""
    aria-hidden="true"
    fetchpriority="high"
    decoding="async"
    class="js-hero-bg-parallax pointer-events-none absolute inset-[-50px] -z-10 h-[calc(100%+100px)] w-[calc(100%+100px)] max-w-none object-cover will-change-transform"
  />
  <!-- Capa 2: fondo hover (ojo ₿ naranja), fade por opacity -->
  <img
    src="/img/hero-bg-orange.png"
    alt=""
    aria-hidden="true"
    loading="eager"
    decoding="async"
    class="js-hero-bg-parallax hero-bg-hover pointer-events-none absolute inset-[-50px] -z-10 h-[calc(100%+100px)] w-[calc(100%+100px)] max-w-none object-cover opacity-0 transition-opacity duration-500 will-change-transform"
    style="transition-timing-function:var(--ease);"
  />
  <!-- Capa 3: overlay gradiente a #111 -->
  <div
    class="pointer-events-none absolute inset-0 -z-10 bg-hero-overlay"
    aria-hidden="true"
  >
  </div>

  <!-- Título: fijo arriba en móvil para no tapar el ojo del fondo -->
  <div class="absolute inset-x-0 top-24 z-10 px-5 text-center sm:top-28 sm:px-6 md:hidden">
    <h1 class="font-serif text-display text-title">
      <span class="block font-display text-bitcoin">Bitcoin</span>
      <span class="font-serif text-title">Explicado para humanos.</span>
    </h1>
  </div>

  <!-- Contenido -->
  <div
    class="relative z-10 mx-auto w-full max-w-[1440px] px-5 py-24 sm:px-6 md:px-10 md:py-32 lg:px-16"
  >
    <Reveal class="w-full">
      <div class="grid grid-cols-1 items-center gap-10 md:grid-cols-2 md:gap-14 lg:gap-20">
        <!-- Title (left, desktop) -->
        <h1 class="hidden font-serif text-display text-title md:block md:text-left">
          <span class="block font-display text-bitcoin">Bitcoin</span>
          <span class="font-serif text-title">Explicado para humanos.</span>
        </h1>

        <!-- Body (right) -->
        <div class="max-w-[486px] justify-self-center md:justify-self-start">
          <p class="text-center font-sans text-body text-white md:text-left">
            Ya ayudé a <b class="font-bold">+500</b> alumnos a dar su primer paso en Bitcoin.
            Sin experiencia previa. Sin conocimientos técnicos. No se trata de curiosidad.
            Se trata de entender las herramientas que la gente exitosa ya usa para construir
            un futuro distinto al que te enseñaron a aceptar.
          </p>

          <div class="mt-8 flex justify-center md:justify-start">
            <a
              href="#temario"
              data-cta-id="quiero_aprender"
              data-whatsapp-message={mensajePara('quiero_aprender')}
              class="js-hero-cta group inline-flex select-none items-center justify-center gap-3 rounded-lg border-2 border-bitcoin px-6 py-4 text-base font-bold text-bitcoin transition-all duration-300 hover:-translate-y-0.5 hover:bg-bitcoin hover:text-black hover:shadow-[0_8px_30px_rgba(247,147,26,0.35)]"
              style="transition-timing-function:var(--ease);"
            >
              <span>Quiero aprender</span>
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                class="transition-transform duration-300 group-hover:translate-x-1"
                style="transition-timing-function:var(--ease);"
              >
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </Reveal>
  </div>
</section>

<style>
  .hero-bg-hover.is-active {
    opacity: 1;
  }
</style>

<script>
  const cta = document.querySelector<HTMLElement>('.js-hero-cta');
  const hoverBg = document.querySelector<HTMLElement>('.hero-bg-hover');

  if (cta && hoverBg) {
    const on = () => hoverBg.classList.add('is-active');
    const off = () => hoverBg.classList.remove('is-active');
    cta.addEventListener('mouseenter', on);
    cta.addEventListener('mouseleave', off);
    cta.addEventListener('focus', on);
    cta.addEventListener('blur', off);
  }

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const heroSection = document.querySelector<HTMLElement>('#inicio');
  const bgLayers = document.querySelectorAll<HTMLElement>('.js-hero-bg-parallax');
  const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

  if (heroSection && bgLayers.length && !prefersReducedMotion && canHover) {
    const MAX_BG_OFFSET = 40;
    let targetX = 0;
    let targetY = 0;
    let currentX = 0;
    let currentY = 0;
    let bgTicking = false;

    const render = () => {
      currentX += (targetX - currentX) * 0.08;
      currentY += (targetY - currentY) * 0.08;
      bgLayers.forEach((layer) => {
        layer.style.transform = `translate3d(${currentX}px, ${currentY}px, 0)`;
      });
      if (Math.abs(targetX - currentX) > 0.05 || Math.abs(targetY - currentY) > 0.05) {
        requestAnimationFrame(render);
      } else {
        bgTicking = false;
      }
    };

    heroSection.addEventListener('mousemove', (e) => {
      const rect = heroSection.getBoundingClientRect();
      const nx = (e.clientX - rect.left) / rect.width - 0.5;
      const ny = (e.clientY - rect.top) / rect.height - 0.5;
      targetX = -nx * MAX_BG_OFFSET;
      targetY = -ny * MAX_BG_OFFSET;
      if (!bgTicking) {
        bgTicking = true;
        requestAnimationFrame(render);
      }
    });

    heroSection.addEventListener('mouseleave', () => {
      targetX = 0;
      targetY = 0;
      if (!bgTicking) {
        bgTicking = true;
        requestAnimationFrame(render);
      }
    });
  }
</script>
