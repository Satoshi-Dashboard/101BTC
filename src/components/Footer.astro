---
import Section from './Section.astro';
import Reveal from './Reveal.astro';

const year = new Date().getFullYear();

// Nav agrupada por categoría (spec Footer b)
const navGroups: { title: string; links: { label: string; href: string }[] }[] = [
  {
    title: 'Curso',
    links: [
      { label: 'Temario', href: '/#temario' },
      { label: 'Precio', href: '/#precio' },
      { label: 'Instructor', href: '/#instructor' },
    ],
  },
  {
    title: 'Recursos',
    links: [
      { label: 'Problema', href: '/#problema' },
      { label: 'Preguntas', href: '/#faq' },
      { label: 'SatoshiDashboard Live', href: 'https://www.satoshidashboard.com/' },
      { label: 'Blog', href: '#' /* [REEMPLAZAR blog] */ },
    ],
  },
  {
    title: 'Legal',
    links: [
      { label: 'Términos', href: '/terminos' },
      { label: 'Privacidad', href: '/privacidad' },
      { label: 'Aviso legal', href: '/aviso-legal' },
    ],
  },
];

// Redes SVG inline feather-style.
const socials: { label: string; href: string; paths: string }[] = [
  {
    label: 'Síguenos en X (Twitter)',
    href: 'https://x.com/ikhunsaa',
    paths:
      '<path d="M4 4l16 16M20 4L4 20" />',
  },
  {
    label: 'Únete al canal de Telegram',
    href: 'https://t.me/ikhunsa',
    paths:
      '<path d="M21 4L3 11l6 2 2 6 3-4 5 5 2-16z" /><polyline points="9 13 16 8" />',
  },
  {
    label: 'Síguenos en TikTok',
    href: '#' /* [REEMPLAZAR: cuenta TikTok pendiente] */,
    paths:
      '<path d="M21 8.5a6.5 6.5 0 0 1-5-2.34V15a6 6 0 1 1-6-6c.34 0 .67.03 1 .09v3.13A3 3 0 1 0 13 15V2h3a6.5 6.5 0 0 0 5 4.5z" fill="currentColor" stroke="none" />',
  },
];
---

<footer class="w-full border-t border-border bg-bg text-muted">
  <Section innerClass="py-14 md:py-16">
    <Reveal>
      <div class="grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-[1.4fr_repeat(3,1fr)] lg:gap-8">
        <!-- (a) Marca -->
        <div class="max-w-sm">
          <a
            href="/#inicio"
            class="inline-flex items-center rounded-md font-display text-2xl text-bitcoin transition-[filter] duration-300 hover:brightness-110 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-bitcoin"
            style="transition-timing-function:var(--ease);"
          >
            Bitcoin
          </a>
          <p class="mt-4 font-sans text-base leading-6 text-muted">
            Explicado para humanos. <span class="text-muted">[REEMPLAZAR tagline]</span>
          </p>
        </div>

        <!-- (b) + (c) Navegación agrupada por categoría / Legal -->
        {
          navGroups.map((group) => (
            <nav aria-label={group.title}>
              <h2 class="font-sans text-sm font-bold uppercase tracking-[0.24px] text-title">
                {group.title}
              </h2>
              <ul class="mt-4 flex flex-col gap-1">
                {group.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      target={link.href.startsWith('http') ? '_blank' : undefined}
                      rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                      class="inline-flex min-h-[44px] items-center font-sans text-base text-muted-light underline-offset-4 transition-colors duration-300 hover:text-bitcoin hover:underline focus-visible:text-bitcoin focus-visible:underline focus-visible:outline-none"
                      style="transition-timing-function:var(--ease);"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          ))
        }
      </div>
    </Reveal>

    <!-- (d) Redes -->
    <Reveal delay={80}>
      <div class="mt-12 flex flex-wrap items-center gap-3">
        {
          socials.map((s) => (
            <a
              href={s.href}
              aria-label={s.label}
              target={s.href.startsWith('http') ? '_blank' : undefined}
              rel={s.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              class="inline-flex h-11 w-11 items-center justify-center rounded-md border border-border text-muted-light transition-colors duration-300 hover:border-bitcoin hover:text-bitcoin focus-visible:border-bitcoin focus-visible:text-bitcoin focus-visible:outline-none"
              style="transition-timing-function:var(--ease);"
            >
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={s.paths}
              />
            </a>
          ))
        }
      </div>
    </Reveal>

    <!-- (e) Descargo de responsabilidad resumido (versión completa en /aviso-legal) -->
    <Reveal delay={120}>
      <p class="mx-auto mt-10 w-full text-center font-sans text-sm leading-6 text-muted">
        <strong class="font-bold text-muted-light">Aviso importante:</strong> 101 BTC
        es un curso educativo. <strong class="font-bold text-muted-light"
          >No es asesoría financiera, de inversión, fiscal ni legal.</strong
        > Bitcoin es volátil y sus transacciones son irreversibles: puedes perder
        todo tu capital. Tus decisiones son tuyas y bajo tu propio riesgo. Nunca
        pedimos claves privadas ni frases semilla. Detalle completo en el
        <a
          href="/aviso-legal#descargo"
          class="text-bitcoin underline underline-offset-4">descargo de responsabilidad</a
        >.
      </p>
    </Reveal>
  </Section>

  <!-- Fila inferior: año dinámico -->
  <div class="border-t border-border">
    <Section innerClass="flex flex-col items-start justify-between gap-4 py-6 sm:flex-row sm:items-center">
      <p class="font-sans text-sm leading-6 text-muted">
        © {year} 101 BTC. <span class="text-muted">[REEMPLAZAR]</span> Todos los derechos reservados.
      </p>
      <a
        href="/#inicio"
        class="inline-flex min-h-[44px] items-center font-sans text-sm text-muted transition-colors duration-300 hover:text-bitcoin focus-visible:text-bitcoin focus-visible:outline-none"
        style="transition-timing-function:var(--ease);"
      >
        Volver arriba
      </a>
    </Section>
  </div>
</footer>
