---
import Section from './Section.astro';
import Button from './Button.astro';
import Reveal from './Reveal.astro';
import Accordion from './Accordion.astro';

// Preguntas/respuestas definidas en el frontmatter.
// Exportado para que index.astro construya el JSON-LD FAQPage (único, en <head> vía Base).
export const FAQ = [
  {
    q: '¿Necesito conocimientos técnicos previos?',
    body: 'No. El curso parte desde cero: no necesitas experiencia previa ni conocimientos técnicos. Cada módulo está pensado para alguien que nunca ha tocado una wallet ni ha comprado Bitcoin.',
  },
  {
    q: '¿Cuánto dura el acceso al curso?',
    body: 'El acceso es de por vida. Pagas una vez y entras a los 10 módulos y 34 clases cuando quieras, a tu ritmo, sin fecha de vencimiento.',
  },
  {
    q: '¿Cómo recibo el material?',
    body: 'Todo el contenido es 100% online: video-clases organizadas por módulo, disponibles para ver cuantas veces necesites desde cualquier dispositivo. En cuanto se confirma tu pago, te llega el acceso por WhatsApp/correo.',
  },
  {
    q: '¿Hay garantía de devolución?',
    body: 'No. Al ser contenido digital de acceso inmediato, no manejamos devoluciones. Antes de comprar, escríbenos si tienes dudas sobre si el curso es para ti.',
  },
  {
    q: '¿Puedo pagar en cuotas?',
    body: 'Por ahora los 3 planes (Básico $47, Completo $77, Mentor 1 a 1 $500) son de pago único, sin cuotas. Escríbenos si tu método de pago local necesita otra modalidad y lo vemos.',
  },
  {
    q: '¿El curso está actualizado?',
    body: 'Sí. Bitcoin y su entorno cambian rápido, así que los módulos se revisan y actualizan de forma periódica, sin costo adicional para quien ya tiene acceso.',
  },
  {
    q: '¿Ofrecen soporte o comunidad?',
    body: 'Sí. Todos los planes incluyen acceso a una comunidad privada de alumnos, y puedes escribirnos directo por WhatsApp para resolver dudas puntuales sobre el contenido.',
  },
];

// Ítems para el Accordion (single-open, ninguno abierto por defecto).
const accordionItems = FAQ.map((item) => ({ q: item.q, body: item.body }));
---

<Section
  id="faq"
  class="bg-bg py-16 sm:py-20 lg:py-28"
  innerClass="flex flex-col gap-10 lg:gap-14"
>
  <!-- Encabezado de la sección -->
  <Reveal class="flex flex-col gap-3">
    <p
      class="flex items-center gap-2 font-sans font-semibold uppercase tracking-[0.24px] text-bitcoin"
      style="font-size:clamp(0.75rem,1.6vw,0.875rem);"
    >
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="currentColor"
        stroke="none"
        aria-hidden="true"
        class="shrink-0 text-bitcoin"
      >
        <path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z" />
      </svg>
      <span>Preguntas frecuentes</span>
    </p>
    <h2
      class="max-w-[640px] font-sans font-bold text-title"
      style="font-size:clamp(2rem,5vw,3rem);line-height:1.15;"
    >
      Resolvemos tus dudas antes de empezar
    </h2>
    <p
      class="max-w-[640px] font-sans text-bitcoin"
      style="font-size:clamp(0.95rem,2.2vw,1rem);line-height:1.5;"
    >
      Todo lo que necesitas saber sobre el curso, el acceso y el acompañamiento.
    </p>
  </Reveal>

  <!-- Acordeón de preguntas (single-open) -->
  <Reveal delay={120} class="w-full">
    <Accordion items={accordionItems} single={true} />
  </Reveal>

  <!-- Bloque CTA final -->
  <Reveal delay={200} class="w-full">
    <div
      class="flex flex-col items-start gap-5 rounded-xl border border-border bg-bg-card p-6 sm:flex-row sm:items-center sm:justify-between sm:p-8"
    >
      <div class="flex flex-col gap-1">
        <p
          class="font-sans font-bold text-title"
          style="font-size:clamp(1.25rem,3vw,1.5rem);line-height:1.2;"
        >
          ¿No encontraste tu respuesta?
        </p>
        <p
          class="font-sans text-muted"
          style="font-size:clamp(0.95rem,2.2vw,1rem);line-height:1.5;"
        >
          Escríbenos y te ayudamos a resolver cualquier duda.
        </p>
      </div>
      <Button
        href="mailto:luisleon.exe@gmail.com"
        variant="outline"
        label="Escríbenos"
        icon="arrow-right"
        class="min-h-[44px] shrink-0"
        ctaId="escribenos"
      />
    </div>
  </Reveal>
</Section>
