---
export interface Props {
  id?: string;
  class?: string;
  /** extra classes for the inner max-width wrapper */
  innerClass?: string;
}

const { id, class: extraClass = '', innerClass = '' } = Astro.props;
---

<section id={id} class={`w-full ${extraClass}`}>
  <div
    class={`mx-auto w-full max-w-[1440px] px-5 sm:px-6 md:px-10 lg:px-16 ${innerClass}`}
  >
    <slot />
  </div>
</section>
