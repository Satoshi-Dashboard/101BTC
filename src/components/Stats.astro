---
import Section from './Section.astro';
import Reveal from './Reveal.astro';

interface Stat {
  value: number;
  suffix?: string;
  label: string;
}

const stats: Stat[] = [
  { value: 500, suffix: '+', label: 'Total de alumnos' },
  { value: 10, label: 'Modulos' },
  { value: 34, label: 'Clases' },
  { value: 0, suffix: '%', label: 'Conocimiento previo requerido' },
];
---

<Section
  class="border-y-2 border-border bg-bg"
  innerClass="py-12 sm:py-14 md:py-16"
>
  <dl
    class="grid grid-cols-1 gap-y-10 sm:grid-cols-2 sm:gap-y-12 lg:grid-cols-4 lg:gap-y-0 lg:gap-x-[clamp(2rem,7vw,101px)]"
  >
    {
      stats.map((stat, i) => (
        <Reveal delay={i * 120} class="text-center lg:text-left">
          <dt
            class="stat-num font-sans font-extrabold text-title leading-none"
            style="font-size:clamp(2.75rem,6vw,64px);"
            data-count-target={stat.value}
            data-count-suffix={stat.suffix ?? ''}
          >
            0{stat.suffix ?? ''}
          </dt>
          <dd class="mt-3 font-sans text-base leading-6 font-normal text-muted">
            {stat.label}
          </dd>
        </Reveal>
      ))
    }
  </dl>
</Section>

<script>
  const nums = Array.from(
    document.querySelectorAll<HTMLElement>('.stat-num[data-count-target]')
  );
  if (nums.length > 0) {
    const prefersReduced = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;

    const animate = (el: HTMLElement) => {
      const target = parseInt(el.dataset.countTarget || '0', 10);
      const suffix = el.dataset.countSuffix || '';
      if (prefersReduced || target === 0) {
        el.textContent = `${target}${suffix}`;
        return;
      }
      const duration = 1200;
      const start = performance.now();
      const easeOutQuad = (t: number) => t * (2 - t);

      const tick = (now: number) => {
        const progress = Math.min((now - start) / duration, 1);
        const current = Math.round(target * easeOutQuad(progress));
        el.textContent = `${current}${suffix}`;
        if (progress < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };

    if (!('IntersectionObserver' in window)) {
      nums.forEach(animate);
    } else {
      const observer = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            animate(entry.target as HTMLElement);
            obs.unobserve(entry.target);
          });
        },
        { root: null, rootMargin: '0px 0px -10% 0px', threshold: 0.4 }
      );
      nums.forEach((el) => observer.observe(el));
    }
  }
</script>
