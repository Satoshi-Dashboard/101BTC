---
import DashboardShell from '../components/DashboardShell.astro';
import { TEMARIO, TODAS_LAS_CLASES } from '../lib/temario';

const totalClases = TODAS_LAS_CLASES.length;
const totalModulos = TEMARIO.length;

// Datos que el cliente necesita para calcular todo desde localStorage
// (progreso real del alumno, no se puede computar en el servidor).
const temarioParaCliente = TEMARIO.map((m) => ({
  slug: m.slug,
  titulo: m.titulo,
  clases: m.clases.map((c) => c.slug),
}));
---

<DashboardShell title="Progreso — Bitcoin 101" active="progreso" crumb={['Progreso']}>
  <script type="application/json" id="temario-data" set:html={JSON.stringify(temarioParaCliente)} />

  <!-- Stats -->
  <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
    <div class="rounded-xl border border-border bg-bg-card p-5">
      <p class="font-sans text-xs text-muted">Módulos completados</p>
      <p id="stat-modulos" class="mt-1 font-sans text-2xl font-bold text-title">0/{totalModulos}</p>
    </div>
    <div class="rounded-xl border border-border bg-bg-card p-5">
      <p class="font-sans text-xs text-muted">Clases vistas</p>
      <p id="stat-clases" class="mt-1 font-sans text-2xl font-bold text-title">0/{totalClases}</p>
    </div>
    <div class="rounded-xl border border-border bg-bg-card p-5">
      <p class="font-sans text-xs text-muted">Racha actual</p>
      <p id="stat-racha" class="mt-1 font-sans text-2xl font-bold text-title">0 días</p>
    </div>
    <div class="rounded-xl border border-border bg-bg-card p-5">
      <p class="font-sans text-xs text-muted">Avance total</p>
      <p id="stat-porcentaje" class="mt-1 font-sans text-2xl font-bold text-title">0%</p>
    </div>
  </div>

  <!-- Mensaje de racha / próxima meta -->
  <p id="racha-mensaje" class="mt-4 font-sans text-sm text-muted"></p>

  <!-- Heatmap de actividad (estilo GitHub) -->
  <div class="mt-10">
    <p id="heatmap-titulo" class="font-sans text-sm font-bold text-title"></p>

    <div class="mt-3 flex gap-4 overflow-x-auto rounded-xl border border-border bg-bg-card p-4">
      <!-- Grid -->
      <div class="min-w-0 flex-1">
        <div id="heatmap-months" class="ml-[24px] flex gap-[3px] font-sans text-[10px] text-muted"></div>
        <div class="mt-1 flex gap-[3px]">
          <div class="flex flex-col justify-between gap-[3px] pr-1 font-sans text-[10px] text-muted">
            <span></span>
            <span>lun</span>
            <span></span>
            <span>mié</span>
            <span></span>
            <span>vie</span>
            <span></span>
          </div>
          <div id="heatmap" class="flex w-fit gap-[3px]"></div>
        </div>
        <div class="mt-3 flex items-center justify-end gap-1.5">
          <span class="font-sans text-xs text-muted">Menos</span>
          <span class="h-3 w-3 rounded-sm bg-white/5"></span>
          <span class="h-3 w-3 rounded-sm bg-bitcoin/25"></span>
          <span class="h-3 w-3 rounded-sm bg-bitcoin/50"></span>
          <span class="h-3 w-3 rounded-sm bg-bitcoin/75"></span>
          <span class="h-3 w-3 rounded-sm bg-bitcoin"></span>
          <span class="font-sans text-xs text-muted">Más</span>
        </div>
      </div>

      <!-- Selector de años -->
      <div id="heatmap-years" class="flex shrink-0 flex-col gap-1 border-l border-border pl-4"></div>
    </div>
  </div>

  <!-- Progreso por módulo -->
  <div class="mt-10">
    <p class="font-sans text-sm font-bold text-title">Progreso por módulo</p>
    <div id="modulos-progreso" class="mt-3 flex flex-col gap-3">
      {
        TEMARIO.map((m) => (
          <div class="rounded-lg border border-border bg-bg-card p-4">
            <div class="flex items-center justify-between gap-4">
              <p class="font-sans text-sm font-medium text-title">
                {m.numero}. {m.titulo}
              </p>
              <p class="font-sans text-xs text-muted" data-modulo-pct={m.slug}>
                0/{m.clases.length}
              </p>
            </div>
            <div class="mt-2 h-1.5 w-full overflow-hidden rounded-pill bg-white/10">
              <div
                class="h-full rounded-pill bg-bitcoin transition-[width] duration-500"
                style="width:0%"
                data-modulo-bar={m.slug}
              />
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <!-- Milestones -->
  <div class="mt-10">
    <p class="font-sans text-sm font-bold text-title">Hitos</p>
    <div class="mt-3 flex flex-col gap-2">
      {
        [
          { key: 'primer-modulo', label: 'Primer módulo completado' },
          { key: 'mitad', label: '50% del curso' },
          { key: 'completo', label: 'Curso completo → certificado' },
        ].map((h) => (
          <div
            data-milestone={h.key}
            class="flex items-center gap-3 rounded-lg border border-border bg-bg-card px-4 py-3"
          >
            <span class="js-milestone-icon flex h-5 w-5 shrink-0 items-center justify-center rounded-full border border-border text-transparent transition-colors duration-300">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="20 6 9 17 4 12" />
              </svg>
            </span>
            <span class="font-sans text-sm text-muted">{h.label}</span>
          </div>
        ))
      }
    </div>
  </div>

  <script>
    interface ModuloData {
      slug: string;
      titulo: string;
      clases: string[];
    }

    const temario: ModuloData[] = JSON.parse(
      document.getElementById('temario-data')?.textContent ?? '[]'
    );
    const todasLasClases = temario.flatMap((m) => m.clases);

    const getProgreso = (): Record<string, string> => {
      try {
        return JSON.parse(localStorage.getItem('bitcoin101_progreso_v2') ?? '{}');
      } catch {
        return {};
      }
    };

    const progreso = getProgreso();
    const completadas = Object.keys(progreso);
    const totalClases = todasLasClases.length;
    const totalModulos = temario.length;

    // --- Stats ---
    const modulosCompletos = temario.filter((m) => m.clases.every((slug) => slug in progreso)).length;
    const pctTotal = totalClases ? Math.round((completadas.length / totalClases) * 100) : 0;

    const statModulos = document.getElementById('stat-modulos');
    const statClases = document.getElementById('stat-clases');
    const statPorcentaje = document.getElementById('stat-porcentaje');
    if (statModulos) statModulos.textContent = `${modulosCompletos}/${totalModulos}`;
    if (statClases) statClases.textContent = `${completadas.length}/${totalClases}`;
    if (statPorcentaje) statPorcentaje.textContent = `${pctTotal}%`;

    // --- Progreso por módulo ---
    temario.forEach((m) => {
      const hechas = m.clases.filter((slug) => slug in progreso).length;
      const pct = m.clases.length ? Math.round((hechas / m.clases.length) * 100) : 0;
      const bar = document.querySelector<HTMLElement>(`[data-modulo-bar="${m.slug}"]`);
      const label = document.querySelector<HTMLElement>(`[data-modulo-pct="${m.slug}"]`);
      if (bar) bar.style.width = `${pct}%`;
      if (label) label.textContent = `${hechas}/${m.clases.length}`;
    });

    // --- Racha (días consecutivos con actividad, terminando hoy o ayer) ---
    const fechas = new Set(Object.values(progreso));
    const toISO = (d: Date) => d.toISOString().slice(0, 10);
    let racha = 0;
    let cursor = new Date();
    // Si hoy no hay actividad, la racha se cuenta desde ayer (sigue "viva" hasta medianoche).
    if (!fechas.has(toISO(cursor))) cursor.setDate(cursor.getDate() - 1);
    while (fechas.has(toISO(cursor))) {
      racha += 1;
      cursor.setDate(cursor.getDate() - 1);
    }
    const statRacha = document.getElementById('stat-racha');
    if (statRacha) statRacha.textContent = `${racha} ${racha === 1 ? 'día' : 'días'}`;

    const mensajeEl = document.getElementById('racha-mensaje');
    if (!mensajeEl) {
      // no-op
    } else if (completadas.length === 0) {
      mensajeEl.textContent = 'Marca tu primera clase como completada para empezar tu racha.';
    } else if (racha > 0) {
      mensajeEl.textContent = `Llevas ${racha} ${racha === 1 ? 'día' : 'días'} seguidos. Completa una clase hoy para mantener la racha.`;
    } else {
      mensajeEl.textContent = 'Tu racha se reinició. Completa una clase hoy para empezar una nueva.';
    }

    // --- Heatmap (año completo, estilo GitHub, navegable) ---
    const heatmap = document.getElementById('heatmap');
    const monthsRow = document.getElementById('heatmap-months');
    const yearsCol = document.getElementById('heatmap-years');
    const tituloEl = document.getElementById('heatmap-titulo');

    if (heatmap && monthsRow && yearsCol && tituloEl) {
    const hoy = new Date();
    hoy.setHours(0, 0, 0, 0);
    const anioActual = hoy.getFullYear();
    const ACTUAL = 'actual'; // vista especial: últimos 365 días rodantes, como GitHub
    let vista: number | typeof ACTUAL = ACTUAL;

    const nivelClase = (n: number) => {
      if (n <= 0) return 'bg-white/5';
      if (n === 1) return 'bg-bitcoin/25';
      if (n === 2) return 'bg-bitcoin/50';
      if (n === 3) return 'bg-bitcoin/75';
      return 'bg-bitcoin';
    };

    // Conteo de clases completadas por fecha
    const conteoPorFecha: Record<string, number> = {};
    Object.values(progreso).forEach((fecha) => {
      conteoPorFecha[fecha] = (conteoPorFecha[fecha] ?? 0) + 1;
    });

    const MESES = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'];

    const renderHeatmap = (v: number | typeof ACTUAL) => {
      vista = v;
      heatmap.innerHTML = '';
      monthsRow.innerHTML = '';

      // Rango visible: "actual" = últimos 365 días terminando hoy (rodante).
      // Un año pasado = ese año calendario completo (1 ene - 31 dic).
      const inicioRango = v === ACTUAL ? new Date(hoy) : new Date(v, 0, 1);
      if (v === ACTUAL) inicioRango.setDate(inicioRango.getDate() - 364);
      const finRango = v === ACTUAL ? hoy : new Date(v, 11, 31);

      tituloEl.textContent =
        v === ACTUAL
          ? `${completadas.length} clase${completadas.length === 1 ? '' : 's'} completadas en el último año`
          : `Actividad en ${v}`;

      Array.from(yearsCol.children).forEach((btn) => {
        const activo = btn.getAttribute('data-year-btn') === String(v);
        btn.classList.toggle('bg-bitcoin', activo);
        btn.classList.toggle('text-black', activo);
        btn.classList.toggle('font-bold', activo);
        btn.classList.toggle('text-muted', !activo);
      });

      // Cuadrícula completa: del lunes de la semana de inicio
      // al domingo de la semana de fin.
      const inicioSemana = (inicioRango.getDay() + 6) % 7;
      const gridInicio = new Date(inicioRango);
      gridInicio.setDate(inicioRango.getDate() - inicioSemana);

      const finSemana = (finRango.getDay() + 6) % 7;
      const gridFin = new Date(finRango);
      gridFin.setDate(finRango.getDate() + (6 - finSemana));

      const totalDias = Math.round((gridFin.getTime() - gridInicio.getTime()) / 86400000) + 1;
      const totalSemanas = Math.ceil(totalDias / 7);

      let mesAnterior = -1;
      for (let semana = 0; semana < totalSemanas; semana++) {
        const col = document.createElement('div');
        col.className = 'flex flex-col gap-[3px]';

        const primerDiaCol = new Date(gridInicio);
        primerDiaCol.setDate(gridInicio.getDate() + semana * 7);
        const mesCol = primerDiaCol.getMonth();
        const enRango = primerDiaCol >= inicioRango && primerDiaCol <= finRango;
        const label = document.createElement('span');
        label.style.width = '12px';
        label.style.whiteSpace = 'nowrap';
        label.textContent = enRango && mesCol !== mesAnterior ? MESES[mesCol] : '';
        if (enRango && mesCol !== mesAnterior) mesAnterior = mesCol;
        monthsRow.appendChild(label);

        for (let dia = 0; dia < 7; dia++) {
          const fecha = new Date(gridInicio);
          fecha.setDate(gridInicio.getDate() + semana * 7 + dia);
          const celda = document.createElement('div');

          const fueraDeRango = fecha < inicioRango || fecha > finRango;
          if (fueraDeRango) {
            celda.className = 'h-3 w-3 rounded-sm bg-transparent';
          } else {
            const iso = toISO(fecha);
            const cuenta = conteoPorFecha[iso] ?? 0;
            celda.className = `h-3 w-3 rounded-sm ${nivelClase(cuenta)}`;
            celda.title = `${iso}: ${cuenta} clase${cuenta === 1 ? '' : 's'}`;
          }
          col.appendChild(celda);
        }
        heatmap.appendChild(col);
      }
    };

    // Selector de años: "2026" (actual, rodante) + 4 años atrás (calendario completo)
    const AÑOS_ATRAS = 4;
    const opciones: (number | typeof ACTUAL)[] = [ACTUAL, ...Array.from({ length: AÑOS_ATRAS }, (_, i) => anioActual - 1 - i)];
    opciones.forEach((op) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.dataset.yearBtn = String(op);
      btn.textContent = op === ACTUAL ? String(anioActual) : String(op);
      btn.className =
        'rounded-lg px-4 py-2 text-left font-sans text-sm font-medium tracking-[0.16px] text-muted transition-colors duration-300 hover:bg-white/10 hover:text-title';
      btn.addEventListener('click', () => renderHeatmap(op));
      yearsCol.appendChild(btn);
    });

    renderHeatmap(ACTUAL);
    }

    // --- Milestones ---
    const paintMilestone = (key: string, done: boolean) => {
      const el = document.querySelector<HTMLElement>(`[data-milestone="${key}"] .js-milestone-icon`);
      el?.classList.toggle('bg-bitcoin', done);
      el?.classList.toggle('border-bitcoin', done);
      el?.classList.toggle('text-black', done);
      el?.classList.toggle('text-transparent', !done);
    };
    paintMilestone('primer-modulo', modulosCompletos >= 1);
    paintMilestone('mitad', pctTotal >= 50);
    paintMilestone('completo', pctTotal >= 100);
  </script>
</DashboardShell>
