---
import Base from '../layouts/Base.astro';

// Cada slide usa su propia imagen en /public/img/login/. Para cambiarla,
// solo reemplaza el archivo (mismo nombre) o edita el campo "image" abajo.
const slides = [
  {
    image: '/img/login/slide-1.svg',
    quote:
      'No te voy a prometer que te harás rico. Te voy a enseñar a que el fruto de tu trabajo deje de esfumarse.',
    name: 'Luis Leon',
    role: 'Instructor de Bitcoin 101',
  },
  {
    image: '/img/login/slide-2.svg',
    quote:
      'Hace más de 5 años no entendía nada de Bitcoin. Ni siquiera sabía qué era una wallet. Me tomó años de estudio para entender cómo funciona el dinero de verdad.',
    name: 'Luis Leon',
    role: 'Instructor de Bitcoin 101',
  },
  {
    image: '/img/login/slide-3.svg',
    quote:
      'Bitcoin 101 es el curso que yo hubiera necesitado cuando empecé. Cada módulo existe porque en algún momento yo mismo me hice esa pregunta.',
    name: 'Luis Leon',
    role: 'Instructor de Bitcoin 101',
  },
];
---

<Base title="Entrar — Bitcoin 101" description="Accede a tus clases de Bitcoin 101.">
  <main class="grid min-h-screen grid-cols-1 bg-dark lg:grid-cols-2">
      <!-- Columna izquierda: formulario -->
      <div class="flex flex-col justify-center gap-8 p-8 sm:p-12 lg:p-14">
        <a href="/#inicio" aria-label="Bitcoin 101" class="w-fit">
          <img src="/img/logo%20largo.svg" alt="Bitcoin 101" class="h-6 w-auto" />
        </a>

        <div class="flex flex-col gap-2">
          <h1 class="font-sans text-2xl font-bold text-title">Bienvenido de vuelta</h1>
          <p class="font-sans text-sm text-muted">
            Ingresa tus datos para entrar a tus clases.
          </p>
        </div>

        <form id="login-form" class="flex flex-col gap-5">
          <div class="flex flex-col gap-2">
            <label for="email" class="font-sans text-sm font-medium text-title">Correo</label>
            <input
              id="email"
              name="email"
              type="email"
              autocomplete="email"
              placeholder="tucorreo@gmail.com"
              class="rounded-lg border border-border bg-bg-card px-4 py-3 font-sans text-sm text-title placeholder:text-muted focus:border-bitcoin focus:outline-none"
            />
          </div>

          <div class="flex flex-col gap-2">
            <label for="password" class="font-sans text-sm font-medium text-title">Contraseña</label>
            <input
              id="password"
              name="password"
              type="password"
              autocomplete="current-password"
              placeholder="Mínimo 8 caracteres"
              class="rounded-lg border border-border bg-bg-card px-4 py-3 font-sans text-sm text-title placeholder:text-muted focus:border-bitcoin focus:outline-none"
            />
          </div>

          <button
            type="submit"
            class="mt-2 rounded-lg bg-bitcoin px-6 py-3 font-sans text-sm font-bold text-black transition-all duration-300 hover:brightness-110 hover:-translate-y-0.5 active:bg-white active:text-black"
            style="transition-timing-function:var(--ease);"
          >
            Entrar
          </button>

          <a
            href="#"
            class="text-center font-sans text-sm text-muted underline decoration-border underline-offset-4 hover:text-title"
          >
            ¿Olvidaste tu contraseña?
          </a>
        </form>
      </div>

      <!-- Columna derecha: imagen + testimonio (carrusel) -->
      <div id="login-carousel" class="relative hidden overflow-hidden lg:block">
        {
          slides.map((s, i) => (
            <img
              src={s.image}
              alt=""
              class="js-carousel-bg absolute inset-0 h-full w-full object-cover transition-opacity duration-500"
              data-bg={i}
              style={i === 0 ? undefined : 'opacity:0;'}
            />
          ))
        }
        <div
          class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-black/40"
        >
        </div>

        <div class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-6 p-10">
          <div class="flex-1">
            <!-- Dots -->
            <div class="mb-4 flex items-center gap-2">
              {
                slides.map((_, i) => (
                  <button
                    type="button"
                    data-dot={i}
                    aria-label={`Ir al testimonio ${i + 1}`}
                    class="js-carousel-dot h-2 w-2 rounded-full bg-white/30 transition-colors duration-300 data-[active=true]:bg-white"
                  />
                ))
              }
            </div>

            <div class="relative min-h-[110px]">
              {
                slides.map((s, i) => (
                  <div
                    class="js-carousel-slide absolute inset-0 flex flex-col justify-start gap-4 transition-opacity duration-300"
                    data-slide={i}
                    style={i === 0 ? undefined : 'opacity:0;pointer-events:none;'}
                  >
                    <p class="font-sans text-lg leading-relaxed text-white">"{s.quote}"</p>
                    <div>
                      <p class="font-sans font-bold text-white">{s.name}</p>
                      <p class="font-sans text-sm text-white/70">{s.role}</p>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>

          <!-- Flechas -->
          <div class="flex shrink-0 items-center gap-2">
            <button
              type="button"
              id="carousel-prev"
              aria-label="Testimonio anterior"
              class="flex h-10 w-10 items-center justify-center rounded-full border border-white/20 text-white transition-all duration-300 hover:-translate-y-0.5 hover:border-bitcoin hover:bg-bitcoin hover:text-black"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="19" y1="12" x2="5" y2="12" />
                <polyline points="12 19 5 12 12 5" />
              </svg>
            </button>
            <button
              type="button"
              id="carousel-next"
              aria-label="Siguiente testimonio"
              class="flex h-10 w-10 items-center justify-center rounded-full border border-white/20 text-white transition-all duration-300 hover:-translate-y-0.5 hover:border-bitcoin hover:bg-bitcoin hover:text-black"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12" />
                <polyline points="12 5 19 12 12 19" />
              </svg>
            </button>
          </div>
        </div>
      </div>
  </main>

  <script>
    // Login aún sin backend: el submit solo simula la entrada y navega al dashboard.
    document.getElementById('login-form')?.addEventListener('submit', (e) => {
      e.preventDefault();
      window.location.href = '/home';
    });

    const root = document.getElementById('login-carousel');
    if (root) {
      const slidesEls = Array.from(root.querySelectorAll<HTMLElement>('.js-carousel-slide'));
      const bgEls = Array.from(root.querySelectorAll<HTMLElement>('.js-carousel-bg'));
      const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('.js-carousel-dot'));
      let current = 0;

      const show = (index: number) => {
        current = (index + slidesEls.length) % slidesEls.length;
        slidesEls.forEach((el, i) => {
          const on = i === current;
          el.style.opacity = on ? '1' : '0';
          el.style.pointerEvents = on ? 'auto' : 'none';
        });
        bgEls.forEach((el, i) => {
          el.style.opacity = i === current ? '1' : '0';
        });
        dots.forEach((dot, i) => {
          dot.dataset.active = String(i === current);
        });
      };

      dots.forEach((dot, i) => dot.addEventListener('click', () => show(i)));
      document.getElementById('carousel-prev')?.addEventListener('click', () => show(current - 1));
      document.getElementById('carousel-next')?.addEventListener('click', () => show(current + 1));

      // Scroll (rueda del mouse) sobre el panel también cambia de slide
      let wheelLocked = false;
      root.addEventListener(
        'wheel',
        (e) => {
          e.preventDefault();
          if (wheelLocked) return;
          wheelLocked = true;
          show(current + (e.deltaY > 0 ? 1 : -1));
          setTimeout(() => (wheelLocked = false), 500);
        },
        { passive: false }
      );

      show(0);
    }
  </script>
</Base>
