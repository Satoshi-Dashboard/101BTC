# Copia este archivo a .env y rellena los valores.
# El prefijo PUBLIC_ es obligatorio: Astro solo expone al navegador las vars con ese prefijo.
# La anon/publishable key es pública por diseño (viaja al navegador). Lo que la protege es
# el RLS de la base de datos, no el secreto. La service_role key NUNCA va aquí.

PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Número de WhatsApp destino: código de país + número, solo dígitos.
# Ej. Ecuador 099 123 4567 -> 593991234567
PUBLIC_WHATSAPP_NUMERO=593991234567
